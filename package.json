{
  "name": "ayush-kursela",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:user": "npm run dev --prefix frontend/user",
    "dev:admin": "npm run dev --prefix frontend/admin",
    "dev:backend": "npm run dev --prefix backend",
    "install:all": "npm install --prefix frontend/user && npm install --prefix frontend/admin && npm install --prefix backend",
    "build": "npm run build:user && npm run build:admin",
    "build:user": "npm run build --prefix frontend/user",
    "build:admin": "npm run build --prefix frontend/admin",
    "start:backend": "npm run start --prefix backend"
  }
}
